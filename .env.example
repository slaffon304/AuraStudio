# ====================================================================
# AuraStudio Environment Configuration Template
# Placeholders ONLY - Never commit real keys or secrets to git.
# ====================================================================

# --------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Vite / Client Safe)
# --------------------------------------------------------------------
# Your Supabase Project URL (e.g. https://your-project.supabase.co)
VITE_SUPABASE_URL="https://your-project.supabase.co"

# Supabase Publishable Key (Safe to bundle into browser)
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-key-here"

# --------------------------------------------------------------------
# 2. SERVER-ONLY ENVIRONMENT VARIABLES (Private - Never expose to browser)
# --------------------------------------------------------------------
# Supabase Secret Key (Server-side privileged database and storage access)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SECRET_KEY="your-secret-key-here"

# Google Gemini API Key (Server-side AI image generation)
GEMINI_API_KEY="your-gemini-api-key-here"

# Optional Payment Gateway Key (e.g., Stripe, Netopia, Paynet)
PAYMENT_GATEWAY_KEY=""

# Optional hosting URL for self-referential links / callbacks
APP_URL="http://localhost:3000"

# Express Server Port
PORT=3000
