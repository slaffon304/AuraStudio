# ====================================================================
# AuraStudio Environment Configuration Template
# ====================================================================

# --------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Vite / Client Safe)
# --------------------------------------------------------------------
# Your Supabase Project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL="https://your-project.supabase.co"

# Your Supabase Public Anonymous API Key (safe to bundle in browser)
VITE_SUPABASE_ANON_KEY="your-anon-key-here"

# --------------------------------------------------------------------
# 2. SERVER-ONLY ENVIRONMENT VARIABLES (Private - Never send to browser)
# --------------------------------------------------------------------
# Supabase Service Role Key: Required by server.ts for privileged operations,
# generating signed URLs, verifying webhooks, and executing atomic balance transactions.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# Google Gemini API Key: Required for server-side real AI photo generation.
# In Google AI Studio, injected automatically at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional Cloud Run / Server hosting URL
APP_URL="http://localhost:3000"

# Server Port
PORT=3000
